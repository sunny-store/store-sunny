{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kedaisunny",
  "main": "src/worker.mjs",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sunny-db",
      "database_id": "ISI_DENGAN_DATABASE_ID_D1_KAMU"
    }
  ],
  "triggers": { "crons": ["0 1 * * *"] },
  "observability": { "enabled": true }
}
